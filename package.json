{
  "name": "tarkov-quest-planner",
  "private": true,
  "version": "0.8.58",
  "type": "module",
  "description": "Planificateur de quêtes Escape from Tarkov sur carte (données tarkov.dev)",
  "scripts": {
    "dev": "vite",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "sync:maps": "node scripts/sync-maps.mjs",
    "sync:items": "node scripts/sync-item-images.mjs",
    "sync:categories": "node scripts/sync-item-categories.mjs",
    "sync:spots": "node scripts/sync-item-spots.mjs",
    "sync:icons": "node scripts/sync-item-icons.mjs",
    "sync:traders": "node scripts/sync-trader-offers.mjs",
    "sync:kappa": "node scripts/sync-kappa.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
